{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "schedule": ["before 6am on monday"],
  "timezone": "America/Los_Angeles",
  "prConcurrentLimit": 4,
  "labels": ["dependencies"],
  "automerge": false,
  "packageRules": [
    {
      "description": "The framework's three packages move together, always at an exact pin: one pull request, and this repository's CI proves the new version",
      "matchPackageNames": ["@mistriwork/engine", "@mistriwork/kit", "@mistriwork/ui"],
      "groupName": "@mistriwork packages",
      "rangeStrategy": "pin",
      "schedule": ["at any time"],
      "automerge": false
    },
    {
      "description": "Dev dependencies move together, by hand: never automerged",
      "matchDepTypes": ["devDependencies"],
      "excludePackageNames": ["@mistriwork/engine", "@mistriwork/kit", "@mistriwork/ui"],
      "groupName": "dev dependencies",
      "automerge": false
    },
    {
      "description": "GitHub Actions, pinned by digest",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Node and the Docker base image are chosen with the release, not by a bot",
      "matchPackageNames": ["node", "node-alpine"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "description": "A security fix is not held for Monday",
    "schedule": ["at any time"],
    "labels": ["dependencies", "security"]
  }
}
