{
  "name": "tablewalk",
  "version": "1.0.0-rc.13",
  "description": "Follow the data. A database browser built around the walk: a foreign key is a place you can go.",
  "keywords": [
    "browser",
    "cli",
    "database",
    "openapi",
    "postgres",
    "rest",
    "schema",
    "sqlite"
  ],
  "homepage": "https://tablewalk.dev",
  "bugs": {
    "url": "https://github.com/rbaljinder/tablewalk/issues"
  },
  "license": "MIT",
  "author": "Baljinder Randhawa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbaljinder/tablewalk.git"
  },
  "bin": {
    "tablewalk": "dist/server/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "tsx src/server/index.ts",
    "demo": "tsx test/make-demo-db.ts .demo/demo.db --scale 3000 && tsx src/server/index.ts --db .demo/demo.db --open",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt \"{src,test,e2e,scripts,desktop}/**/*.{ts,tsx,js,mjs,cjs,mts}\" \"{*,config/*}.{ts,mjs,js,cjs,mts}\"",
    "format:check": "oxfmt --check \"{src,test,e2e,scripts,desktop}/**/*.{ts,tsx,js,mjs,cjs,mts}\" \"{*,config/*}.{ts,mjs,js,cjs,mts}\"",
    "test": "node scripts/test-node.mjs",
    "test:components": "vitest run",
    "test:built:browser": "node test/built-client-browser.mjs",
    "test:built:vitals": "node test/built-client-vitals.mjs",
    "e2e": "node scripts/test-e2e.mjs",
    "smoke": "playwright test e2e/smoke-tablewalk.spec.ts",
    "build:site": "npm --prefix site run build",
    "seed:live": "tsx test/seed-live.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@mistriwork/engine": "1.0.0-rc.14",
    "@mistriwork/kit": "1.0.0-rc.14",
    "@mistriwork/ui": "1.0.0-rc.14"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@playwright/test": "^1.62.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-mention": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rolldown": "^1.2.15",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vite": "^8.2.4",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
