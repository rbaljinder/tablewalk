{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "es2024": true,
    "node": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": "off",
    "unicorn/no-useless-fallback-in-spread": "off",
    "unicorn/no-useless-spread": "off"
  },
  "overrides": [
    {
      "files": ["src/client/**"],
      "env": {
        "browser": true,
        "node": false
      }
    },
    {
      "files": ["e2e/**"],
      "env": {
        "browser": true,
        "node": true
      }
    }
  ],
  "ignorePatterns": ["dist", "node_modules", "e2e/.tmp", "desktop", "site", ".demo"]
}
